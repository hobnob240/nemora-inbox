{
  // NEMORA inbox: receives nemora.uk contact-form messages and serves the private admin at /admin.
  // No secrets in this file. Set SETUP_CODE (and optionally RESEND_API_KEY) as secrets in Cloudflare.
  "name": "nemora-inbox",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  // lets the site monitor reach our other *.workers.dev sites over the public internet
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "none",
    "html_handling": "auto-trailing-slash"
  },
  "kv_namespaces": [
    { "binding": "KV","id": "82378f21b57241db9e748c0a30aa112d" }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "nemora-analytics", "database_id": "46b63d89-a211-40a1-a3a7-8bebd6d15ef3" }
  ],
  // daily clean-up of visit statistics; every 15 minutes: check client sites are up
  "triggers": { "crons": ["17 3 * * *", "*/15 * * * *"] },
  "vars": {
    "SITE_ORIGINS": "https://nemora.uk,https://www.nemora.uk",
    // Facebook Login for Business configuration for the admin's Connect button (public, not a secret)
    "META_LOGIN_CONFIG_ID": "1129926852870365",
    "META_APP_ID": "1804536077441262"
  },
  "observability": { "enabled": true }
}
